# Public Supabase configuration for the deployed prototype.
#
# Committed on purpose. Both values are NEXT_PUBLIC_*: they are compiled
# into the browser bundle and are visible to anyone who opens the app in
# devtools, by design. Supabase's publishable key grants nothing on its
# own — every table is behind row level security and requires a signed-in
# session, and privileged actions re-check the caller's role inside
# Postgres. The service-role key is the secret one, and it is not here
# and never reaches the web tier.
#
# Vercel environment variables override these if set in the dashboard.
NEXT_PUBLIC_SUPABASE_URL=https://ugsiqoqofujmotqrayhp.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_yW0KCzUd620zBjjkoXHXrA_lQnpQvAT
